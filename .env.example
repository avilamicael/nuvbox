# ========================================
# CONFIGURAÇÃO CEREBRO BACKEND
# Copie este arquivo para .env e ajuste valores
# ========================================

# Configuração PostgreSQL
# Para usar PostgreSQL local via Docker: deixe DB_HOST=postgres (padrão)
# Para usar Supabase ou PostgreSQL externo: defina DB_HOST com o host externo
DB_HOST=postgres                   # 'postgres' = Docker local | host externo = Supabase/VPS
DB_PORT=5432
DB_USER=cerebro
DB_PASSWORD=sua_senha_segura_aqui
DB_NAME=cerebro_db

# Configuração do Microfone
MIC_DEVICE_ID=0                    # 0 = dispositivo padrão
MIC_SAMPLE_RATE=16000
MIC_CHUNK_SIZE=512                 # amostras por chunk

# Configuração Whisper
WHISPER_MODEL=small                # tiny, base, small, medium, large
WHISPER_LANGUAGE=pt                # pt, en, deixe em branco para auto-detectar

# Configuração Silero VAD
VAD_SILENCE_DURATION_MS=500        # ms de silêncio para terminar enunciado
VAD_MIN_SPEECH_DURATION_MS=300     # ms mínimo para ser considerado fala

# Webhook / Segurança (usado por todos os clientes: Pinky, Alexa, ESP32, etc.)
CEREBRO_SECRET=mude_antes_do_ngrok

# ========================================
# MÓDULO 4 - Processamento IA (LLM)
# API compatível com OpenAI: Groq, OpenAI, Anthropic, Google, etc.
# ========================================

# --- GROQ (padrão — free tier, modelos rápidos) ---
LLM_API_KEY=gsk...                        # Chave Groq: console.groq.com
LLM_MODEL=llama-3.1-8b-instant            # Modelos Groq: llama-3.1-8b-instant | llama-3.3-70b-versatile | gemma2-9b-it
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
LLM_COST_INPUT_PER_1M=0.0                 # Groq free tier = $0
LLM_COST_OUTPUT_PER_1M=0.0

# --- OpenAI (alternativa paga) ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=                           # vazio = usa default OpenAI
# LLM_PROVIDER=openai
# LLM_COST_INPUT_PER_1M=0.15
# LLM_COST_OUTPUT_PER_1M=0.60

# --- Configurações do batch worker ---
MODULO4_BATCH_SIZE=15              # Transcrições por lote
MODULO4_POLL_INTERVAL_SECONDS=180  # Intervalo de polling (3 min)
MODULO4_IMPORTANCE_THRESHOLD=0.25  # Score mínimo para salvar
MODULO4_DAILY_COST_LIMIT_USD=2.00  # Limite diário ($) — 0 = sem limite
MODULO4_MAX_RETRIES=3              # Tentativas com backoff
MODULO4_DRY_RUN=true              # true = não insere no banco (teste)

# NOTA FUTURA: quando houver uma UI de admin (tipo Django Admin), migrar
# providers para tabela llm_providers no banco para gerenciar múltiplas
# contas Groq, OpenAI, Anthropic etc. com fallback automático via interface.

# Logging
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR

# ========================================
# CLIENTE WINDOWS (windows_mic_sender.py)
# ========================================
BACKEND_URL=http://localhost:5001  # localhost = WSL2 local | IP = VPS remota
CLIENT_SOURCE_ID=windows_mic       # Identificador desta máquina no banco de dados

# ========================================
# DOCKER INTERNO (normalmente sem mudanças)
# ========================================
LOG_DIR=/app/logs
