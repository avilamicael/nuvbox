# PostgreSQL Configuration
# ⚠️  IMPORTANT FOR DOCKER: When using docker-compose, set this to "postgres" (service name)
# For local development, use "localhost"
DB_HOST=postgres
DB_PORT=5432
DB_USER=cerebro
DB_PASSWORD=cerebro
DB_NAME=cerebro_db

# Microphone Configuration
MIC_DEVICE_ID=0                    # 0 = default device, or use sd.query_devices() to find ID
MIC_SAMPLE_RATE=16000
MIC_CHUNK_SIZE=512                 # samples per chunk

# Whisper Configuration
WHISPER_MODEL=small                # tiny, base, small, medium, large
WHISPER_LANGUAGE=pt                # pt for Portuguese, en for English, None for auto-detect

# Silero VAD Configuration
VAD_SILENCE_DURATION_MS=500        # ms of silence to end utterance
VAD_MIN_SPEECH_DURATION_MS=300     # ms minimum to be considered speech

# Flask/Alexa Webhook
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
ALEXA_WEBHOOK_SECRET=change_me_before_ngrok

# Logging
LOG_DIR=logs
LOG_LEVEL=DEBUG

# Queues (internal, usually no change)
RAW_AUDIO_QUEUE_MAX_SIZE=100
TEXT_QUEUE_MAX_SIZE=100
